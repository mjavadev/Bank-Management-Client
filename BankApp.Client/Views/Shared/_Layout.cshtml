<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Banking Application</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-color: #1e3a5f;
            --primary-dark: #152d47;
            --primary-light: #2c5f8d;
            --success-color: #27ae60;
            --navbar-height: 56px;
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%) !important;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            padding: 0.5rem 1rem;
            min-height: var(--navbar-height);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.25rem;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: transform 0.2s ease;
        }

            .navbar-brand:hover {
                transform: translateY(-2px);
            }

            .navbar-brand i {
                font-size: 1.4rem;
            }

        .nav-link {
            font-weight: 500;
            font-size: 0.9rem;
            padding: 0.5rem 0.9rem !important;
            border-radius: 6px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .nav-link:hover {
                background-color: rgba(255, 255, 255, 0.1);
                transform: translateY(-1px);
            }

            .nav-link i {
                font-size: 0.9rem;
            }

        .dropdown-menu {
            border: none;
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
            border-radius: 8px;
            padding: 0.5rem;
            margin-top: 0.5rem;
        }

        .dropdown-item {
            border-radius: 6px;
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .dropdown-item:hover {
                background-color: rgba(30, 58, 95, 0.1);
                transform: translateX(4px);
            }

            .dropdown-item i {
                font-size: 0.85rem;
                width: 18px;
            }

        .dropdown-divider {
            margin: 0.5rem 0;
        }

        .main-wrapper {
            flex: 1 0 auto;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }

        .container-fluid {
            padding-left: 1.5rem;
            padding-right: 1.5rem;
        }

        .footer {
            flex-shrink: 0;
            margin-top: auto;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%) !important;
            border-top: none !important;
            padding: 0.8rem 0 !important;
            font-size: 0.875rem !important;
            width: 100%;
        }

            .footer span {
                color: white !important;
                font-weight: 500 !important;
            }

        .toast-success {
            background-color: var(--success-color) !important;
        }

        .toast-error {
            background-color: #e74c3c !important;
        }

        .toast-info {
            background-color: #3498db !important;
        }

        .toast-warning {
            background-color: #f39c12 !important;
        }

        .navbar-toggler {
            border: none;
            padding: 0.5rem;
        }

            .navbar-toggler:focus {
                box-shadow: none;
                outline: 2px solid rgba(255,255,255,0.3);
            }

        .navbar-toggler-icon {
            width: 1.5rem;
            height: 1.5rem;
        }

        @@media (max-width: 991px) {
            .navbar-collapse

        {
            margin-top: 1rem;
            background: rgba(255, 255, 255, 0.05);
            padding: 1rem;
            border-radius: 8px;
        }

        .nav-link {
            padding: 0.6rem 1rem !important;
            margin: 0.2rem 0;
        }

        .dropdown-menu {
            background-color: rgba(255, 255, 255, 0.95);
            margin-left: 1rem;
        }

        .navbar-nav {
            gap: 0.3rem;
        }

        }

        @@media (min-width: 992px) {
            .navbar-nav

        {
            gap: 0.3rem;
        }

        }

        .nav-item .active {
            background-color: rgba(255, 255, 255, 0.15);
            font-weight: 600;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                    <i class="fas fa-university"></i>
                    <span>Banking App</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    @if (User.Identity.IsAuthenticated)
                    {
                        var roles = User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();

                        <ul class="navbar-nav me-auto">
                            @if (roles.Contains("Customer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Dashboard", "Customer")">
                                        <i class="fas fa-tachometer-alt"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("CreateTransaction", "Customer")">
                                        <i class="fas fa-exchange-alt"></i> New Transaction
                                    </a>
                                </li>
                            }

                            @if (roles.Contains("Manager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Dashboard", "Manager")">
                                        <i class="fas fa-tachometer-alt"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-file-alt"></i> Applications
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@Url.Action("Applications", "Manager")"><i class="fas fa-list"></i> All Applications</a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("PendingApplications", "Manager")"><i class="fas fa-clock"></i> Pending Applications</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-exchange-alt"></i> Transactions
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@Url.Action("Transactions", "Manager")"><i class="fas fa-list"></i> All Transactions</a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("PendingTransactions", "Manager")"><i class="fas fa-clock"></i> Pending Transactions</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Customers", "Manager")">
                                        <i class="fas fa-users"></i> Customers
                                    </a>
                                </li>
                            }

                            @if (roles.Contains("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Dashboard", "Admin")">
                                        <i class="fas fa-tachometer-alt"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-users-cog"></i> Employees
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@Url.Action("Employees", "Admin")"><i class="fas fa-list"></i> All Employees</a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("CreateEmployee", "Admin")"><i class="fas fa-plus"></i> Create Employee</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-file-alt"></i> Applications
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@Url.Action("Applications", "Manager")"><i class="fas fa-list"></i> All Applications</a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("PendingApplications", "Manager")"><i class="fas fa-clock"></i> Pending Applications</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-exchange-alt"></i> Transactions
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@Url.Action("Transactions", "Manager")"><i class="fas fa-list"></i> All Transactions</a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("PendingTransactions", "Manager")"><i class="fas fa-clock"></i> Pending Transactions</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Customers", "Manager")">
                                        <i class="fas fa-users"></i> Customers
                                    </a>
                                </li>
                            }
                        </ul>

                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("ChangePassword", "Account")">
                                            <i class="fas fa-key"></i> Change Password
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Logout", "Account")">
                                            <i class="fas fa-sign-out-alt"></i> Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Login", "Account")">
                                    <i class="fas fa-sign-in-alt"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Create", "Application")">
                                    <i class="fas fa-user-plus"></i> Apply Now
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="main-wrapper">
        <div class="container-fluid mt-3">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer">
        <div class="container-fluid text-center">
            <span>&copy; 2025 Banking Application. All rights reserved.</span>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>

        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };

        @if (TempData["SuccessMessage"] != null)
        {
                    <text>
                    toastr.success('@TempData["SuccessMessage"]');
                    </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
                    <text>
                    toastr.error('@TempData["ErrorMessage"]');
                    </text>
        }

        @if (TempData["InfoMessage"] != null)
        {
                    <text>
                    toastr.info('@TempData["InfoMessage"]');
                    </text>
        }

        @if (TempData["WarningMessage"] != null)
        {
                    <text>
                    toastr.warning('@TempData["WarningMessage"]');
                    </text>
        }
    </script>
</body>
</html>
