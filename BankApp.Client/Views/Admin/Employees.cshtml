@model List<BankApp.Client.Dto.EmployeeDto>

@{
    ViewData["Title"] = "Employees";
}

<style>
    :root {
        --bank-primary: #1e3a5f;
        --bank-secondary: #2c5f8d;
        --bank-accent: #3498db;
        --bank-success: #27ae60;
        --bank-edit: #e67e22;
        --bank-danger: #e74c3c;
        --bank-light: #f8f9fa;
        --bank-border: #e1e8ed;
        --bank-shadow: rgba(30, 58, 95, 0.08);
    }

    .employees-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
        min-height: calc(100vh - 56px - 50px);
        padding: 20px 0;
    }

    .page-header {
        margin-bottom: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

        .page-header h2 {
            color: var(--bank-primary);
            font-weight: 700;
            font-size: 1.4rem;
            margin: 0;
            display: flex;
            align-items: center;
        }

            .page-header h2 i {
                margin-right: 10px;
                color: var(--bank-accent);
                font-size: 1.2rem;
            }

    .employee-count-badge {
        background: linear-gradient(135deg, var(--bank-accent) 0%, var(--bank-secondary) 100%);
        color: white;
        padding: 4px 12px;
        border-radius: 15px;
        font-size: 0.8rem;
        font-weight: 600;
        margin-left: 10px;
    }

    .btn-add-employee {
        background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
        border: none;
        padding: 8px 20px;
        font-size: 0.92rem;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px var(--bank-shadow);
        color: white;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-add-employee:hover {
            background: linear-gradient(135deg, var(--bank-secondary) 0%, var(--bank-primary) 100%);
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(30, 58, 95, 0.21);
            text-decoration: none;
        }

    .employees-card {
        background: white;
        border-radius: 10px;
        border: 1px solid var(--bank-border);
        box-shadow: 0 2px 8px var(--bank-shadow);
        overflow: hidden;
    }

    .employees-card-body {
        padding: 0;
    }

    /* Success Alert */
    .alert-success {
        background: linear-gradient(135deg, rgba(39, 174, 96, 0.1) 0%, rgba(39, 174, 96, 0.05) 100%);
        border-left: 4px solid var(--bank-success);
        color: var(--bank-primary);
        padding: 12px 16px;
        border-radius: 7px;
        margin-bottom: 16px;
        font-size: 0.92rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .alert-success i {
            color: var(--bank-success);
            font-size: 1.1rem;
        }

        .alert-success .close-btn {
            margin-left: auto;
            cursor: pointer;
            color: var(--bank-success);
            font-size: 1.3rem;
            line-height: 1;
        }

    /* DataTable Styling */
    .table-container {
        padding: 14px;
    }

    #employeesTable {
        width: 100% !important;
        border-collapse: separate;
        border-spacing: 0;
    }

        #employeesTable thead th {
            background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
            color: white;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.3px;
            padding: 10px 8px;
            border: none;
            position: sticky;
            top: 0;
            z-index: 10;
        }

            #employeesTable thead th:first-child {
                border-top-left-radius: 6px;
            }

            #employeesTable thead th:last-child {
                border-top-right-radius: 6px;
            }

        #employeesTable tbody tr {
            transition: all 0.2s ease;
            border-bottom: 1px solid var(--bank-border);
        }

            #employeesTable tbody tr:hover {
                background: linear-gradient(90deg, rgba(52, 152, 219, 0.05) 0%, rgba(30, 58, 95, 0.03) 100%);
                transform: scale(1.01);
                box-shadow: 0 1px 5px rgba(30, 58, 95, 0.06);
            }

        #employeesTable tbody td {
            padding: 10px 8px;
            vertical-align: middle;
            color: var(--bank-primary);
            font-size: 0.89rem;
        }

        #employeesTable td:first-child {
            font-weight: 600;
            color: var(--bank-accent);
        }

    .action-buttons {
        display: flex;
        gap: 6px;
        justify-content: flex-start;
    }

    .btn-action {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        cursor: pointer;
        font-size: 0.8rem;
    }

    .btn-edit {
        background: linear-gradient(135deg, rgba(230, 126, 34, 0.18) 0%, rgba(230, 126, 34, 0.25) 100%);
        color: var(--bank-edit);
    }

        .btn-edit:hover {
            background: linear-gradient(135deg, var(--bank-edit) 0%, #d35400 100%);
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(230, 126, 34, 0.19);
        }

    .btn-delete {
        background: linear-gradient(135deg, rgba(231, 76, 60, 0.12) 0%, rgba(231, 76, 60, 0.22) 100%);
        color: var(--bank-danger);
    }

        .btn-delete:hover {
            background: linear-gradient(135deg, var(--bank-danger) 0%, #c0392b 100%);
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(231, 76, 60, 0.16);
        }

    .date-badge {
        display: inline-block;
        padding: 4px 10px;
        background: rgba(52, 152, 219, 0.09);
        border-radius: 5px;
        font-size: 0.88rem;
        color: var(--bank-primary);
    }

    .empty-state {
        text-align: center;
        padding: 50px 20px;
    }

    .empty-state-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, var(--bank-light) 0%, #e9ecef 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
    }

        .empty-state-icon i {
            font-size: 2.1rem;
            color: var(--bank-accent);
        }

    .empty-state h4 {
        color: var(--bank-primary);
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 1.05rem;
    }

    .empty-state p {
        color: #6c757d;
        font-size: 0.93rem;
        margin-bottom: 18px;
    }

    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
        border: 1.5px solid var(--bank-border);
        border-radius: 6px;
        padding: 6px 10px;
        transition: all 0.2s ease;
        font-size: 0.9rem;
    }

        .dataTables_wrapper .dataTables_length select:focus,
        .dataTables_wrapper .dataTables_filter input:focus {
            border-color: var(--bank-accent);
            outline: none;
            box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.09);
        }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
        border-radius: 7px;
        padding: 6px 12px;
        margin: 0 2px;
        border: 1.5px solid var(--bank-border);
        background: white;
        color: var(--bank-primary);
        transition: all 0.2s ease;
        font-size: 0.88rem;
    }

        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
            color: white !important;
            border-color: var(--bank-primary);
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
            color: white !important;
            border-color: var(--bank-primary);
        }

    .dataTables_wrapper .dataTables_info {
        color: #6c757d;
        font-size: 0.89rem;
        padding: 8px 0;
    }

    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        padding: 8px 0;
        font-size: 0.88rem;
    }

    @@media (max-width: 768px) {
        .page-header h2

    {
        font-size: 1.1rem;
    }

    .table-container {
        padding: 8px;
    }

    .btn-add-employee {
        width: 100%;
        justify-content: center;
    }

    }
</style>

<div class="employees-container">
    <div class="container-fluid px-3">
        @{
            var successMessage = TempData["SuccessMessage"] as string;
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div id="successAlert" class="alert-success">
                <i class="fas fa-check-circle"></i>
                <span>@successMessage</span>
                <span class="close-btn" onclick="$('#successAlert').fadeOut(300);">&times;</span>
            </div>
        }

        <div class="page-header">
            <h2>
                <i class="fas fa-users-cog"></i> All Employees
                @if (Model.Any())
                {
                    <span class="employee-count-badge">@Model.Count</span>
                }
            </h2>
            <a href="@Url.Action("CreateEmployee")" class="btn-add-employee">
                <i class="fas fa-plus"></i> Add Employee
            </a>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="employees-card">
                    <div class="employees-card-body">
                        @if (Model.Any())
                        {
                            <div class="table-container">
                                <div class="table-responsive">
                                    <table class="table" id="employeesTable">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Username</th>
                                                <th>Full Name</th>
                                                <th>Staff Code</th>
                                                <th>Job Title</th>
                                                <th>Date Hired</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var emp in Model)
                                            {
                                                <tr>
                                                    <td>@emp.EmployeeID</td>
                                                    <td>@emp.UserName</td>
                                                    <td>@emp.FullName</td>
                                                    <td>@emp.StaffCode</td>
                                                    <td>@emp.JobTitle</td>
                                                    <td>
                                                        <span class="date-badge">
                                                            <i class="far fa-calendar-alt"></i>
                                                            @emp.DateHired.ToString("dd MMM yyyy")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="action-buttons">
                                                            <a href="@Url.Action("EditEmployee", new { id = emp.EmployeeID })"
                                                               class="btn-action btn-edit"
                                                               title="Edit Employee">
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                            <button class="btn-action btn-delete"
                                                                    onclick="deleteEmployee(@emp.EmployeeID)"
                                                                    title="Delete Employee">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <i class="fas fa-users-slash"></i>
                                </div>
                                <h4>No Employees Found</h4>
                                <p>Get started by adding your first employee to the system.</p>
                                <a href="@Url.Action("CreateEmployee")" class="btn-add-employee">
                                    <i class="fas fa-plus"></i> Add First Employee
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var employeesTable;

        $(document).ready(function() {

            employeesTable = $('#employeesTable').DataTable({
                "pageLength": 25,
                "order": [[0, "desc"]],
                "language": {
                    "search": "Search employees:",
                    "lengthMenu": "Show _MENU_ per page",
                    "info": "Showing _START_ to _END_ of _TOTAL_ employees",
                    "infoEmpty": "No employees available",
                    "infoFiltered": "(filtered from _MAX_ total employees)",
                    "paginate": {
                        "first": "First",
                        "last": "Last",
                        "next": "Next",
                        "previous": "Prev"
                    }
                },
                "responsive": true
            });

            if ($('#successAlert').length > 0) {
                
                setTimeout(function() {
                    reloadEmployeesTable();
                }, 500);

                setTimeout(function() {
                    $('#successAlert').fadeOut(300);
                }, 5000);
            }
        });

        function reloadEmployeesTable() {

            $.ajax({
                url: '@Url.Action("Employees")',
                type: 'GET',
                success: function(data) {

                    var newRows = $(data).find('#employeesTable tbody tr');

                    employeesTable.clear();
                    employeesTable.rows.add(newRows);
                    employeesTable.draw();

                    var newCount = newRows.length;
                    var badgeHtml = newCount > 0 ?
                        '<span class="employee-count-badge">' + newCount + '</span>' : '';

                    $('.page-header h2 .employee-count-badge').remove();
                    $('.page-header h2').append(badgeHtml);
                },
                error: function() {
                    toastr.error('Failed to refresh employee list');
                }
            });
        }

        function deleteEmployee(id) {
            if(confirm('Are you sure you want to delete this employee? This action cannot be undone.')) {
                $.ajax({
                    url: '@Url.Action("DeleteEmployee")/' + id,
                    type: 'POST',
                    success: function(response) {
                        if(response.success) {
                            toastr.success(response.message || 'Employee deleted successfully');
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            toastr.error(response.message || 'Failed to delete employee');
                        }
                    },
                    error: function() {
                        toastr.error('An error occurred while deleting the employee');
                    }
                });
            }
        }
    </script>
}
