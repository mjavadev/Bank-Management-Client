@using BankApp.Client.ViewModels
@model EditEmployeeViewModel

@{
    ViewData["Title"] = "Edit Employee";
    var employeeId = ViewBag.EmployeeId;
}

<style>
    :root {
        --bank-primary: #1e3a5f;
        --bank-secondary: #2c5f8d;
        --bank-accent: #3498db;
        --bank-edit: #e67e22;
        --bank-edit-dark: #d35400;
        --bank-light: #f8f9fa;
        --bank-border: #e1e8ed;
        --bank-shadow: rgba(30, 58, 95, 0.08);
    }

    .edit-form-container {
        min-height: calc(100vh - 56px - 50px);
        background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
        padding: 22px 0;
    }

    .edit-form-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 3px 12px var(--bank-shadow);
        border: 1px solid var(--bank-border);
        overflow: hidden;
        transition: transform 0.2s ease;
    }

    .edit-form-card:hover {
        transform: translateY(-1px) scale(1.01);
        box-shadow: 0 7px 22px rgba(230, 126, 34, 0.19);
    }

    .edit-form-header {
        background: linear-gradient(135deg, var(--bank-edit) 0%, var(--bank-edit-dark) 100%);
        padding: 17px 20px 12px 20px;
        position: relative;
        overflow: hidden;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }

    .edit-form-header h4 {
        font-size: 1.23rem;
        font-weight: 600;
        color: white;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 9px;
        z-index: 1;
        position: relative;
    }

    .edit-form-header i {
        font-size: 1.11rem;
    }

    .edit-badge {
        display: inline-block;
        background: rgba(255, 255, 255, 0.21);
        padding: 4px 14px;
        border-radius: 14px;
        font-size: 0.79rem;
        font-weight: 600;
        margin-left: 9px;
        letter-spacing: 0.4px;
        color: #fff9ed;
    }

    .edit-form-body {
        padding: 22px 20px;
    }

    .form-info-banner {
        background: linear-gradient(90deg, rgba(230, 126, 34, 0.08) 0%, rgba(211, 84, 0, 0.04) 100%);
        border-left: 4px solid var(--bank-edit);
        padding: 12px 16px;
        border-radius: 7px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
    }

    .form-info-banner i {
        font-size: 1.1rem;
        color: var(--bank-edit);
        margin-right: 11px;
    }

    .form-info-banner p {
        margin: 0;
        color: var(--bank-primary);
        font-size: 0.93rem;
        line-height: 1.5;
    }

    .form-label {
        font-weight: 600;
        color: var(--bank-primary);
        margin-bottom: 5px;
        font-size: 0.95rem;
        letter-spacing: 0.2px;
        display: flex;
        align-items: center;
    }

    .form-control {
        border: 1.5px solid var(--bank-border);
        border-radius: 6px;
        padding: 9px 13px;
        font-size: 0.99rem;
        margin-bottom: 2px;
        background-color: #fafbfc;
        transition: border-color 0.17s;
    }

    .form-control:focus {
        border-color: var(--bank-edit);
        box-shadow: 0 0 0 3px rgba(230, 126, 34, 0.13);
        background-color: white;
    }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 1px;
    }

    .required-indicator {
        color: #dc3545;
        margin-left: 3px;
    }

    .validation-summary {
        background: #fff3cd;
        border-left: 4px solid #ffc107;
        padding: 12px 16px;
        border-radius: 7px;
        margin-bottom: 12px;
        font-size: 0.92rem;
    }

    .btn-update {
        background: linear-gradient(135deg, var(--bank-edit) 0%, var(--bank-edit-dark) 100%);
        border: none;
        padding: 11px 0;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 7px;
        transition: all 0.19s ease;
        box-shadow: 0 2px 10px rgba(230, 126, 34, 0.14);
        color: white;
        width: 100%;
    }

    .btn-update:hover {
        background: linear-gradient(135deg, var(--bank-edit-dark) 0%, var(--bank-edit) 100%);
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(230, 126, 34, 0.23);
    }

    .btn-back {
        background: white;
        border: 1.5px solid var(--bank-border);
        color: var(--bank-primary);
        padding: 11px 0;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 7px;
        transition: all 0.17s ease;
        width: 100%;
        text-decoration: none;
        display: inline-block;
    }

    .btn-back:hover {
        background: var(--bank-light);
        border-color: var(--bank-secondary);
        color: var(--bank-secondary);
        text-decoration: none;
    }

    .btn-group-actions {
        display: flex;
        gap: 12px;
        margin-top: 18px;
    }

    .btn-group-actions button,
    .btn-group-actions a {
        flex: 1;
        text-align: center;
        min-width: 0;
    }

    @@media (max-width: 768px) {
        .edit-form-body { padding: 11px 7px 15px 7px; }
        .edit-form-header { padding: 11px 7px 8px 7px; }
        .btn-group-actions { flex-direction: column; gap: 8px; }
        .edit-form-card { border-radius: 8px; }
        .edit-form-header { border-radius: 8px 8px 0 0; }
    }
</style>

<div class="edit-form-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-10">
                <div class="edit-form-card">
                    <div class="edit-form-header">
                        <h4>
                            <i class="fas fa-edit"></i> Edit Employee
                            <span class="edit-badge">MODIFY MODE</span>
                        </h4>
                    </div>
                    <div class="edit-form-body">
                        <div class="form-info-banner">
                            <i class="fas fa-info-circle"></i>
                            <p>You are modifying existing employee information. All changes will be saved immediately upon submission.</p>
                        </div>
                        <form asp-action="EditEmployee" asp-route-id="@employeeId" method="post">
                            @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ApplicationUserId" />
                            <div asp-validation-summary="ModelOnly" class="validation-summary text-danger"></div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="UserName" class="form-label">
                                        Username<span class="required-indicator">*</span>
                                    </label>
                                    <input asp-for="UserName" class="form-control" placeholder="Enter username" readonly/>
                                    <span asp-validation-for="UserName" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="FullName" class="form-label">
                                        Full Name<span class="required-indicator">*</span>
                                    </label>
                                    <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="StaffCode" class="form-label">
                                        Staff Code<span class="required-indicator">*</span>
                                    </label>
                                    <input asp-for="StaffCode" class="form-control" placeholder="Enter staff code" />
                                    <span asp-validation-for="StaffCode" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="JobTitle" class="form-label">
                                        Job Title<span class="required-indicator">*</span>
                                    </label>
                                    <input asp-for="JobTitle" class="form-control" placeholder="Enter job title" />
                                    <span asp-validation-for="JobTitle" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="DateHired" class="form-label">
                                    Date Hired<span class="required-indicator">*</span>
                                </label>
                                <input asp-for="DateHired" type="date" class="form-control" />
                                <span asp-validation-for="DateHired" class="text-danger"></span>
                            </div>

                            <div class="btn-group-actions">
                                <button type="submit" class="btn btn-update">
                                    <i class="fas fa-save"></i> Update
                                </button>
                                <a href="@Url.Action("Employees")" class="btn btn-back">
                                    <i class="fas fa-arrow-left"></i> Back
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
