@using BankApp.Client.ViewModels
@model EmployeeViewModel

@{
    ViewData["Title"] = "Create Employee";
}

<style>
    :root {
        --bank-primary: #1e3a5f;
        --bank-secondary: #2c5f8d;
        --bank-accent: #3498db;
        --bank-success: #27ae60;
        --bank-light: #f8f9fa;
        --bank-border: #e1e8ed;
        --bank-shadow: rgba(30, 58, 95, 0.08);
    }

    .employee-form-container {
        min-height: calc(100vh - 56px - 50px);
        background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
        padding: 22px 0;
    }

    .form-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 3px 12px var(--bank-shadow);
        border: 1px solid var(--bank-border);
        overflow: hidden;
        transition: transform 0.2s ease;
    }

    .form-card:hover {
        transform: translateY(-1px) scale(1.01);
        box-shadow: 0 7px 20px rgba(30, 58, 95, 0.13);
    }

    .form-header {
        background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
        padding: 18px 20px 12px 20px;
        position: relative;
        overflow: hidden;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }

    .form-header h4 {
        font-size: 1.3rem;
        font-weight: 600;
        color: white;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-header i {
        font-size: 1.15rem;
    }

    .form-body {
        padding: 24px 20px;
    }

    .form-label {
        font-weight: 600;
        color: var(--bank-primary);
        margin-bottom: 5px;
        font-size: 0.95rem;
        letter-spacing: 0.3px;
    }

    .form-control {
        border: 1.5px solid var(--bank-border);
        border-radius: 6px;
        padding: 9px 13px;
        font-size: 0.99rem;
        margin-bottom: 2px;
        transition: border-color 0.18s;
    }

    .form-control:focus {
        border-color: var(--bank-accent);
        box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.09);
    }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 1px;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
        border: none;
        padding: 11px 0;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 7px;
        transition: all 0.21s ease;
        box-shadow: 0 2px 10px rgba(30, 58, 95, 0.16);
        color: white;
        width: 100%;
    }

    .btn-primary-custom:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(30, 58, 95, 0.22);
        background: linear-gradient(135deg, var(--bank-secondary) 0%, var(--bank-primary) 100%);
    }

    .btn-secondary-custom {
        background: white;
        border: 1.5px solid var(--bank-border);
        color: var(--bank-primary);
        padding: 11px 0;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 7px;
        transition: all 0.2s ease;
        width: 100%;
    }

    .btn-secondary-custom:hover {
        background: var(--bank-light);
        border-color: var(--bank-secondary);
        color: var(--bank-secondary);
    }

    .btn-group-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .btn-group-actions button,
    .btn-group-actions a {
        flex: 1;
        min-width: 0;
    }

    .required-indicator {
        color: #dc3545;
        margin-left: 3px;
    }

    .validation-summary {
        background: #fff3cd;
        border-left: 4px solid #ffc107;
        padding: 12px 16px;
        border-radius: 7px;
        margin-bottom: 16px;
        font-size: 0.92rem;
    }

    @@media (max-width: 768px) {
        .form-body { padding: 14px 10px 16px 10px; }
        .form-header { padding: 15px 10px 10px 10px; }
        .btn-group-actions { flex-direction: column; gap: 8px; }
        .form-card { border-radius: 8px; }
        .form-header { border-radius: 8px 8px 0 0; }
    }
</style>

<div class="employee-form-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-10">
                <div class="form-card">
                    <div class="form-header">
                        <h4><i class="fas fa-user-plus"></i>Create Employee</h4>
                    </div>
                    <div class="form-body">
                        <form asp-action="CreateEmployee" method="post">
                            <div asp-validation-summary="ModelOnly" class="validation-summary text-danger"></div>
                            <input type="hidden" asp-for="ApplicationUserId" value="123" />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="UserName" class="form-label">
                                        Username<span class="required-indicator">*</span>
                                    </label>
                                    <input asp-for="UserName" class="form-control" placeholder="Enter username" />
                                    <span asp-validation-for="UserName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FullName" class="form-label">
                                        Full Name<span class="required-indicator">*</span>
                                    </label>
                                    <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Password" class="form-label">
                                        Password<span class="required-indicator">*</span>
                                    </label>
                                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="StaffCode" class="form-label">
                                        Staff Code<span class="required-indicator">*</span>
                                    </label>
                                    <input asp-for="StaffCode" class="form-control" placeholder="Enter staff code" />
                                    <span asp-validation-for="StaffCode" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="JobTitle" class="form-label">
                                        Job Title<span class="required-indicator">*</span>
                                    </label>
                                    <input asp-for="JobTitle" class="form-control" placeholder="Enter job title" />
                                    <span asp-validation-for="JobTitle" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="DateHired" class="form-label">
                                        Date Hired<span class="required-indicator">*</span>
                                    </label>
                                    <input asp-for="DateHired" type="date" class="form-control" />
                                    <span asp-validation-for="DateHired" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="btn-group-actions">
                                <button type="submit" class="btn btn-primary-custom">
                                    <i class="fas fa-save"></i> Create
                                </button>
                                <a href="@Url.Action("Employees")" class="btn btn-secondary-custom">
                                    <i class="fas fa-arrow-left"></i> Back
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
