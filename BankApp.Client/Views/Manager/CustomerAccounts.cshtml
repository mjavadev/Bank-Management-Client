@model List<BankApp.Client.Dto.AccountDto>

@{
    ViewData["Title"] = $"Accounts - {ViewBag.CustomerName}";
    var customerName = ViewBag.CustomerName as string;
    var customerId = ViewBag.CustomerID as int?;
    var customerUsername = ViewBag.CustomerUsername as string;
}

<style>
    :root {
        --bank-primary: #1e3a5f;
        --bank-secondary: #2c5f8d;
        --bank-accent: #3498db;
        --bank-success: #27ae60;
        --bank-warning: #f39c12;
        --bank-danger: #e74c3c;
        --bank-info: #16a085;
        --bank-light: #f8f9fa;
        --bank-border: #e1e8ed;
        --bank-shadow: rgba(30, 58, 95, 0.08);
    }

    .accounts-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
        min-height: calc(100vh - 56px - 50px);
        padding: 20px 0;
    }

    /* Breadcrumb Navigation */
    .breadcrumb-nav {
        background: white;
        border-radius: 8px;
        padding: 12px 18px;
        margin-bottom: 16px;
        box-shadow: 0 2px 6px var(--bank-shadow);
    }

        .breadcrumb-nav a {
            color: var(--bank-accent);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.85rem;
            transition: color 0.2s ease;
        }

            .breadcrumb-nav a:hover {
                color: var(--bank-primary);
            }

        .breadcrumb-nav span {
            color: #6c757d;
            margin: 0 8px;
            font-size: 0.85rem;
        }

        .breadcrumb-nav .current {
            color: var(--bank-primary);
            font-weight: 600;
            font-size: 0.85rem;
        }

    /* Page Header */
    .page-header {
        background: white;
        border-radius: 10px;
        padding: 20px 24px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px var(--bank-shadow);
        border-left: 4px solid var(--bank-accent);
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .customer-avatar-large {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--bank-accent) 0%, #2980b9 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .header-info h2 {
        color: var(--bank-primary);
        font-weight: 700;
        font-size: 1.5rem;
        margin: 0 0 6px 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .header-info h2 i {
            color: var(--bank-accent);
            font-size: 1.3rem;
        }

    .page-subtitle {
        color: #6c757d;
        font-size: 0.9rem;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .page-subtitle i {
            color: var(--bank-accent);
        }

    /* Statistics Overview */
    .stats-overview {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: white;
        border-radius: 10px;
        padding: 18px 22px;
        box-shadow: 0 2px 10px var(--bank-shadow);
        border-left: 3px solid;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 120px;
            height: 120px;
            background: radial-gradient(circle, rgba(52, 152, 219, 0.08) 0%, transparent 70%);
            border-radius: 50%;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 16px rgba(30, 58, 95, 0.12);
        }

        .stat-card.total-accounts {
            border-left-color: var(--bank-accent);
        }

        .stat-card.total-balance {
            border-left-color: var(--bank-success);
        }

        .stat-card.active-accounts {
            border-left-color: var(--bank-info);
        }

    .stat-label {
        color: #6c757d;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
        position: relative;
        z-index: 1;
    }

    .stat-value {
        color: var(--bank-primary);
        font-size: 1.8rem;
        font-weight: 700;
        margin: 0;
        position: relative;
        z-index: 1;
    }

        .stat-value.currency {
            font-family: 'Courier New', monospace;
        }

    /* Main Card */
    .accounts-card {
        background: white;
        border-radius: 10px;
        border: 1px solid var(--bank-border);
        box-shadow: 0 2px 10px var(--bank-shadow);
        overflow: hidden;
    }

    .accounts-card-header {
        background: linear-gradient(135deg, var(--bank-light) 0%, #ffffff 100%);
        padding: 16px 20px;
        border-bottom: 2px solid var(--bank-border);
    }

        .accounts-card-header h5 {
            margin: 0;
            color: var(--bank-primary);
            font-weight: 700;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .accounts-card-header h5 i {
                color: var(--bank-accent);
            }

    .accounts-card-body {
        padding: 20px;
    }

    /* Accounts Table */
    .accounts-table {
        width: 100%;
        font-size: 0.9rem;
    }

        .accounts-table thead th {
            background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
            color: white;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.3px;
            padding: 12px 10px;
            border: none;
            white-space: nowrap;
        }

            .accounts-table thead th:first-child {
                border-top-left-radius: 6px;
            }

            .accounts-table thead th:last-child {
                border-top-right-radius: 6px;
            }

        .accounts-table tbody tr {
            transition: all 0.2s ease;
            border-bottom: 1px solid var(--bank-border);
        }

            .accounts-table tbody tr:hover {
                background: linear-gradient(90deg, rgba(52, 152, 219, 0.05) 0%, rgba(30, 58, 95, 0.03) 100%);
            }

        .accounts-table tbody td {
            padding: 12px 10px;
            vertical-align: middle;
            color: var(--bank-primary);
        }

        .accounts-table tbody tr:last-child {
            border-bottom: none;
        }

    /* Account Number Styling */
    .account-number {
        font-weight: 700;
        color: var(--bank-accent);
        font-family: 'Courier New', monospace;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
    }

    /* Account Type Badge */
    .account-type-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.8rem;
        white-space: nowrap;
    }

    .badge-savings {
        background: rgba(39, 174, 96, 0.15);
        color: var(--bank-success);
    }

    .badge-current {
        background: rgba(52, 152, 219, 0.15);
        color: var(--bank-accent);
    }

    .badge-fixed {
        background: rgba(243, 156, 18, 0.15);
        color: var(--bank-warning);
    }

    /* Balance Display */
    .balance-amount {
        font-weight: 700;
        font-size: 1rem;
        font-family: 'Courier New', monospace;
        color: var(--bank-success);
    }

        .balance-amount.negative {
            color: var(--bank-danger);
        }

    /* Status Badges */
    .status-badge {
        padding: 5px 12px;
        border-radius: 14px;
        font-weight: 600;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
    }

    .badge-active {
        background: rgba(39, 174, 96, 0.15);
        color: var(--bank-success);
    }

    .badge-inactive {
        background: rgba(108, 117, 125, 0.15);
        color: #6c757d;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 24px;
    }

    .empty-state-icon {
        width: 90px;
        height: 90px;
        background: linear-gradient(135deg, var(--bank-light) 0%, #e9ecef 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

        .empty-state-icon i {
            font-size: 3rem;
            color: var(--bank-accent);
        }

    .empty-state h5 {
        color: var(--bank-primary);
        font-weight: 600;
        margin-bottom: 10px;
        font-size: 1.2rem;
    }

    .empty-state p {
        color: #6c757d;
        font-size: 0.95rem;
    }

    /* DataTables Custom Styling */
    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
        border: 1px solid var(--bank-border);
        border-radius: 6px;
        padding: 6px 10px;
        transition: all 0.2s ease;
        font-size: 0.85rem;
    }

        .dataTables_wrapper .dataTables_length select:focus,
        .dataTables_wrapper .dataTables_filter input:focus {
            border-color: var(--bank-accent);
            outline: none;
            box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.1);
        }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
        border-radius: 6px;
        padding: 6px 12px;
        margin: 0 3px;
        border: 1px solid var(--bank-border);
        background: white;
        color: var(--bank-primary);
        transition: all 0.2s ease;
        font-size: 0.85rem;
    }

        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
            color: white !important;
            border-color: var(--bank-primary);
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
            color: white !important;
            border-color: var(--bank-primary);
        }

    .dataTables_wrapper .dataTables_info {
        color: #6c757d;
        font-size: 0.8rem;
        padding: 10px 0;
    }

    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        margin-bottom: 14px;
    }

    @@media (max-width: 768px) {
        .accounts-container {
            padding: 15px 0;
        }

        .page-header {
            padding: 16px 18px;
        }

        .header-content {
            flex-direction: column;
            text-align: center;
        }

        .header-info h2 {
            font-size: 1.2rem;
            justify-content: center;
        }

        .page-subtitle {
            justify-content: center;
        }

        .stats-overview {
            grid-template-columns: 1fr;
        }

        .accounts-card-body {
            padding: 14px;
        }

        .accounts-table {
            font-size: 0.8rem;
        }

            .accounts-table thead th,
            .accounts-table tbody td {
                padding: 8px 6px;
            }
    }
</style>

<div class="accounts-container">
    <div class="container-fluid">
        <!-- Breadcrumb Navigation -->
        <div class="breadcrumb-nav">
            <a href="@Url.Action("Index", "Manager")">
                <i class="fas fa-users"></i> All Customers
            </a>
            <span>/</span>
            <span class="current">@customerName's Accounts</span>
        </div>

        <!-- Page Header -->
        <div class="page-header">
            <div class="header-content">
                <div class="customer-avatar-large">
                    @customerName?.Substring(0, 1).ToUpper()
                </div>
                <div class="header-info">
                    <h2>
                        <i class="fas fa-wallet"></i>
                        @customerName's Accounts
                    </h2>
                    <p class="page-subtitle">
                        <i class="fas fa-user"></i>
                        <strong>Customer ID:</strong> #@customerId
                        <span style="margin: 0 8px;">|</span>
                        <strong>Username:</strong> @customerUsername
                    </p>
                </div>
            </div>
        </div>

        <!-- Statistics Overview -->
        @if (Model.Any())
        {
            var totalAccounts = Model.Count();
            var totalBalance = Model.Sum(a => a.Balance);
            var activeAccounts = Model.Count(a => a.IsActive);

            <div class="stats-overview">
                <div class="stat-card total-accounts">
                    <div class="stat-label">
                        <i class="fas fa-wallet"></i> Total Accounts
                    </div>
                    <h3 class="stat-value">@totalAccounts</h3>
                </div>
                <div class="stat-card total-balance">
                    <div class="stat-label">
                        <i class="fas fa-coins"></i> Total Balance
                    </div>
                    <h3 class="stat-value currency">₹@totalBalance.ToString("N2")</h3>
                </div>
                <div class="stat-card active-accounts">
                    <div class="stat-label">
                        <i class="fas fa-check-circle"></i> Active Accounts
                    </div>
                    <h3 class="stat-value">@activeAccounts</h3>
                </div>
            </div>
        }

        <!-- Main Accounts Card -->
        <div class="row">
            <div class="col-12">
                <div class="accounts-card">
                    <div class="accounts-card-header">
                        <h5><i class="fas fa-table"></i> Account Details</h5>
                    </div>
                    <div class="accounts-card-body">
                        @if (Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="accounts-table table" id="accountsTable">
                                    <thead>
                                        <tr>
                                            <th>Account ID</th>
                                            <th>Account Number</th>
                                            <th>Account Type</th>
                                            <th>Balance</th>
                                            <th>Open Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var account in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <span style="font-weight: 600; color: var(--bank-primary);">#@account.AccountID</span>
                                                </td>
                                                <td>
                                                    <span class="account-number">@account.AccountNumber</span>
                                                </td>
                                                <td>
                                                    @{
                                                        var badgeClass = account.AccountTypeID switch
                                                        {
                                                            1 => "badge-savings",
                                                            2 => "badge-current",
                                                            3 => "badge-fixed",
                                                            _ => "badge-savings"
                                                        };

                                                        var icon = account.AccountTypeID switch
                                                        {
                                                            1 => "fa-piggy-bank",
                                                            2 => "fa-briefcase",
                                                            3 => "fa-lock",
                                                            _ => "fa-wallet"
                                                        };
                                                    }
                                                    <span class="account-type-badge @badgeClass">
                                                        <i class="fas @icon"></i> @account.AccountTypeName
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="balance-amount @(account.Balance < 0 ? "negative" : "")">
                                                        ₹@account.Balance.ToString("N2")
                                                    </span>
                                                </td>
                                                <td>
                                                    <div>@account.OpenDate.ToString("dd MMM yyyy")</div>
                                                    <small style="color: #6c757d; font-size: 0.75rem;">@account.OpenDate.ToString("HH:mm")</small>
                                                </td>
                                                <td>
                                                    @if (account.IsActive)
                                                    {
                                                        <span class="status-badge badge-active">
                                                            <i class="fas fa-check-circle"></i> Active
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status-badge badge-inactive">
                                                            <i class="fas fa-ban"></i> Inactive
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <i class="fas fa-wallet"></i>
                                </div>
                                <h5>No Accounts Found</h5>
                                <p>This customer doesn't have any bank accounts yet.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#accountsTable').DataTable({
                "pageLength": 10,
                "order": [[0, "asc"]],
                "language": {
                    "search": "Search accounts:",
                    "lengthMenu": "Show _MENU_ accounts per page",
                    "info": "Showing _START_ to _END_ of _TOTAL_ accounts",
                    "infoEmpty": "No accounts available",
                    "infoFiltered": "(filtered from _MAX_ total accounts)",
                    "paginate": {
                        "first": "First",
                        "last": "Last",
                        "next": "Next",
                        "previous": "Prev"
                    }
                },
                "responsive": true,
                "dom": '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip'
            });
        });
    </script>
}
