@model List<BankApp.Client.Dto.CustomerDto>

@{
    ViewData["Title"] = "Customers";
}

<style>
    :root {
        --bank-primary: #1e3a5f;
        --bank-secondary: #2c5f8d;
        --bank-accent: #3498db;
        --bank-success: #27ae60;
        --bank-warning: #f39c12;
        --bank-danger: #e74c3c;
        --bank-info: #16a085;
        --bank-light: #f8f9fa;
        --bank-border: #e1e8ed;
        --bank-shadow: rgba(30, 58, 95, 0.08);
    }

    .customers-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
        min-height: calc(100vh - 56px - 50px);
        padding: 20px 0;
    }

    /* Page Header */
    .page-header {
        background: white;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px var(--bank-shadow);
        border-left: 4px solid var(--bank-success);
    }

        .page-header h2 {
            color: var(--bank-primary);
            font-weight: 700;
            font-size: 1.4rem;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .page-header h2 i {
                color: var(--bank-success);
                font-size: 1.3rem;
            }

    .page-subtitle {
        color: #6c757d;
        margin-top: 4px;
        font-size: 0.85rem;
    }

    /* Statistics Overview */
    .stats-overview {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: white;
        border-radius: 10px;
        padding: 16px 20px;
        box-shadow: 0 2px 10px var(--bank-shadow);
        border-left: 3px solid;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 120px;
            height: 120px;
            background: radial-gradient(circle, rgba(52, 152, 219, 0.08) 0%, transparent 70%);
            border-radius: 50%;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 16px rgba(30, 58, 95, 0.1);
        }

        .stat-card.total {
            border-left-color: var(--bank-accent);
        }

        .stat-card.active {
            border-left-color: var(--bank-success);
        }

        .stat-card.inactive {
            border-left-color: #6c757d;
        }

    .stat-label {
        color: #6c757d;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
        position: relative;
        z-index: 1;
    }

    .stat-value {
        color: var(--bank-primary);
        font-size: 1.7rem;
        font-weight: 700;
        margin: 0;
        position: relative;
        z-index: 1;
    }

    /* Main Card */
    .customers-card {
        background: white;
        border-radius: 10px;
        border: 1px solid var(--bank-border);
        box-shadow: 0 2px 10px var(--bank-shadow);
        overflow: hidden;
    }

    .customers-card-header {
        background: linear-gradient(135deg, var(--bank-light) 0%, #ffffff 100%);
        padding: 14px 18px;
        border-bottom: 2px solid var(--bank-border);
    }

        .customers-card-header h5 {
            margin: 0;
            color: var(--bank-primary);
            font-weight: 700;
            font-size: 1.05rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .customers-card-header h5 i {
                color: var(--bank-success);
            }

    .customers-card-body {
        padding: 18px;
    }

    /* Customers Table */
    .customers-table {
        width: 100%;
        font-size: 0.85rem;
    }

        .customers-table thead th {
            background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
            color: white;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.3px;
            padding: 10px 8px;
            border: none;
            white-space: nowrap;
        }

            .customers-table thead th:first-child {
                border-top-left-radius: 6px;
            }

            .customers-table thead th:last-child {
                border-top-right-radius: 6px;
            }

        .customers-table tbody tr {
            transition: all 0.2s ease;
            border-bottom: 1px solid var(--bank-border);
        }

            .customers-table tbody tr:hover {
                background: linear-gradient(90deg, rgba(39, 174, 96, 0.05) 0%, rgba(30, 58, 95, 0.03) 100%);
            }

        .customers-table tbody td {
            padding: 10px 8px;
            vertical-align: middle;
            color: var(--bank-primary);
        }

        .customers-table tbody tr:last-child {
            border-bottom: none;
        }

    /* Customer ID Styling */
    .customer-id {
        font-weight: 600;
        color: var(--bank-accent);
        font-family: 'Courier New', monospace;
        font-size: 0.8rem;
    }

    /* Username Badge */
    .username-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        background: rgba(52, 152, 219, 0.1);
        border-radius: 6px;
        color: var(--bank-accent);
        font-weight: 600;
        font-size: 0.8rem;
    }

    /* Customer Name Styling */
    .customer-name {
        font-weight: 600;
        color: var(--bank-primary);
    }

    /* Sensitive Data Styling */
    .sensitive-data {
        font-family: 'Courier New', monospace;
        letter-spacing: 0.5px;
        color: var(--bank-primary);
        font-weight: 500;
        font-size: 0.8rem;
    }

    /* Status Badges */
    .status-badge {
        padding: 4px 10px;
        border-radius: 14px;
        font-weight: 600;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
    }

    .badge-active {
        background: rgba(39, 174, 96, 0.15);
        color: var(--bank-success);
    }

    .badge-inactive {
        background: rgba(108, 117, 125, 0.15);
        color: #6c757d;
    }

    /* Action Buttons */
    .action-btn {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-view-accounts {
        background: linear-gradient(135deg, var(--bank-accent) 0%, #2980b9 100%);
        color: white;
    }

        .btn-view-accounts:hover {
            background: linear-gradient(135deg, #2980b9 0%, var(--bank-accent) 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(52, 152, 219, 0.3);
            color: white;
        }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 50px 24px;
    }

    .empty-state-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, var(--bank-light) 0%, #e9ecef 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
    }

        .empty-state-icon i {
            font-size: 2.5rem;
            color: var(--bank-success);
        }

    .empty-state h5 {
        color: var(--bank-primary);
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 1.1rem;
    }

    .empty-state p {
        color: #6c757d;
        font-size: 0.9rem;
    }

    /* Customer Avatar */
    .customer-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--bank-success) 0%, #229954 100%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 0.9rem;
        margin-right: 10px;
        flex-shrink: 0;
    }

    /* DataTables Custom Styling */
    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
        border: 1px solid var(--bank-border);
        border-radius: 6px;
        padding: 6px 10px;
        transition: all 0.2s ease;
        font-size: 0.85rem;
    }

        .dataTables_wrapper .dataTables_length select:focus,
        .dataTables_wrapper .dataTables_filter input:focus {
            border-color: var(--bank-success);
            outline: none;
            box-shadow: 0 0 0 2px rgba(39, 174, 96, 0.1);
        }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
        border-radius: 6px;
        padding: 6px 12px;
        margin: 0 3px;
        border: 1px solid var(--bank-border);
        background: white;
        color: var(--bank-primary);
        transition: all 0.2s ease;
        font-size: 0.85rem;
    }

        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
            color: white !important;
            border-color: var(--bank-primary);
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
            color: white !important;
            border-color: var(--bank-primary);
        }

    .dataTables_wrapper .dataTables_info {
        color: #6c757d;
        font-size: 0.8rem;
        padding: 10px 0;
    }

    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        margin-bottom: 12px;
    }

    @@media (max-width: 768px) {
        .customers-container {
            padding: 15px 0;
        }

        .page-header {
            padding: 12px 16px;
        }

            .page-header h2 {
                font-size: 1.2rem;
            }

        .stats-overview {
            grid-template-columns: 1fr;
        }

        .customers-card-body {
            padding: 12px;
        }

        .customer-avatar {
            display: none;
        }

        .customers-table {
            font-size: 0.8rem;
        }

            .customers-table thead th,
            .customers-table tbody td {
                padding: 8px 6px;
            }
    }
</style>

<div class="customers-container">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h2>
                <i class="fas fa-users"></i>
                All Customers
            </h2>
            <p class="page-subtitle">View and manage all registered banking customers</p>
        </div>

        <!-- Statistics Overview -->
        @if (Model.Any())
        {
            var totalCount = Model.Count();
            var activeCount = Model.Count(c => c.IsActive);
            var inactiveCount = Model.Count(c => !c.IsActive);

            <div class="stats-overview">
                <div class="stat-card total">
                    <div class="stat-label">
                        <i class="fas fa-user-friends"></i> Total Customers
                    </div>
                    <h3 class="stat-value">@totalCount</h3>
                </div>
                <div class="stat-card active">
                    <div class="stat-label">
                        <i class="fas fa-user-check"></i> Active Customers
                    </div>
                    <h3 class="stat-value">@activeCount</h3>
                </div>
                <div class="stat-card inactive">
                    <div class="stat-label">
                        <i class="fas fa-user-slash"></i> Inactive Customers
                    </div>
                    <h3 class="stat-value">@inactiveCount</h3>
                </div>
            </div>
        }

        <!-- Main Customers Card -->
        <div class="row">
            <div class="col-12">
                <div class="customers-card">
                    <div class="customers-card-header">
                        <h5><i class="fas fa-table"></i> Customer Directory</h5>
                    </div>
                    <div class="customers-card-body">
                        @if (Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="customers-table table" id="customersTable">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Customer</th>
                                            <th>Username</th>
                                            <th>Date of Birth</th>
                                            <th>Mobile</th>
                                            <th>PAN</th>
                                            <th>Approval Date</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var customer in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="customer-id">#@customer.CustomerID</span>
                                                </td>
                                                <td>
                                                    <div style="display: flex; align-items: center;">
                                                        <div class="customer-avatar">
                                                            @customer.FullName.Substring(0, 1).ToUpper()
                                                        </div>
                                                        <span class="customer-name">@customer.FullName</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="username-badge">
                                                        <i class="fas fa-user"></i>@customer.UserName
                                                    </span>
                                                </td>
                                                <td>
                                                    <span>@customer.DateOfBirth.ToString("dd MMM yyyy")</span>
                                                </td>
                                                <td>
                                                    <span class="sensitive-data">@customer.MobileNumber</span>
                                                </td>
                                                <td>
                                                    <span class="sensitive-data">@customer.PAN</span>
                                                </td>
                                                <td>
                                                    @if (customer.ApprovalDate.HasValue)
                                                    {
                                                        <div>@customer.ApprovalDate.Value.ToString("dd MMM yyyy")</div>
                                                        <small style="color: #6c757d; font-size: 0.75rem;">@customer.ApprovalDate.Value.ToString("HH:mm")</small>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: #6c757d; font-style: italic; font-size: 0.8rem;">Not approved</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (customer.IsActive)
                                                    {
                                                        <span class="status-badge badge-active">
                                                            <i class="fas fa-check-circle"></i> Active
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status-badge badge-inactive">
                                                            <i class="fas fa-ban"></i> Inactive
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    <a href="@Url.Action("CustomerAccounts", "Manager", new { customerId = customer.CustomerID })"
                                                       class="action-btn btn-view-accounts"
                                                       title="View all accounts for @customer.FullName">
                                                        <i class="fas fa-wallet"></i> View Accounts
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <i class="fas fa-users"></i>
                                </div>
                                <h5>No Customers Found</h5>
                                <p>There are currently no registered customers in the system. Approved applications will create customer records that appear here.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#customersTable').DataTable({
                "pageLength": 25,
                "order": [[0, "desc"]],
                "language": {
                    "search": "Search customers:",
                    "lengthMenu": "Show _MENU_ customers per page",
                    "info": "Showing _START_ to _END_ of _TOTAL_ customers",
                    "infoEmpty": "No customers available",
                    "infoFiltered": "(filtered from _MAX_ total customers)",
                    "paginate": {
                        "first": "First",
                        "last": "Last",
                        "next": "Next",
                        "previous": "Prev"
                    }
                },
                "responsive": true,
                "dom": '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip',
                "columnDefs": [
                    { "orderable": false, "targets": 8 } // Disable sorting on Actions column
                ]
            });
        });
    </script>
}
