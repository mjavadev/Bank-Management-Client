@model BankApp.Client.Dto.EditCustomerDto

@{
    ViewData["Title"] = "Edit Customer";
}

<style>
    /* Re-use the best styles from your application form */
    .form-group-custom {
        margin-bottom: 12px;
    }

    .btn-submit {
        background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
        color: white;
        font-weight: 600;
        border-radius: 6px;
        padding: 8px 24px;
        border: none;
        transition: all 0.2s;
    }

        .btn-submit:hover {
            background: linear-gradient(135deg, #229954 0%, #27ae60 100%);
        }

    .btn-back {
        background: white;
        border: 1px solid #e1e8ed;
        color: #1e3a5f;
        padding: 8px 24px;
        border-radius: 6px;
        font-weight: 600;
        margin-left: 8px;
        transition: all 0.2s;
        text-decoration: none;
    }
</style>

<h2>Edit Customer Details</h2>

<form asp-action="EditCustomer" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CustomerID" />
    <input type="hidden" asp-for="UserName" />
    <input type="hidden" asp-for="ApplicationUserID" />

    <div class="form-group-custom">
        <label asp-for="FullName">Full Name<span style="color:#dc3545">*</span></label>
        <input asp-for="FullName" class="form-control" maxlength="100" placeholder="Full name as per ID" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="form-group-custom">
        <label asp-for="DateOfBirth">Date of Birth<span style="color:#dc3545">*</span></label>
        <input asp-for="DateOfBirth" type="date" class="form-control" min="1920-01-01" max="@DateTime.Now.AddYears(-10).ToString("yyyy-MM-dd")" />
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>
    <div class="form-group-custom">
        <label asp-for="Gender">Gender<span style="color:#dc3545">*</span></label>
        <select asp-for="Gender" class="form-control">
            <option value="">Select Gender</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
        </select>
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>
    <div class="form-group-custom">
        <label asp-for="Occupation">Occupation<span style="color:#dc3545">*</span></label>
        <input asp-for="Occupation" class="form-control" maxlength="50" />
        <span asp-validation-for="Occupation" class="text-danger"></span>
    </div>
    <div class="form-group-custom">
        <label asp-for="MobileNumber">Mobile Number<span style="color:#dc3545">*</span></label>
        <input asp-for="MobileNumber" class="form-control" maxlength="10" pattern="\d{10}" placeholder="10 digits" />
        <span asp-validation-for="MobileNumber" class="text-danger"></span>
    </div>
    <div class="form-group-custom">
        <label asp-for="AadharNumber">Aadhar Number<span style="color:#dc3545">*</span></label>
        <input asp-for="AadharNumber" class="form-control" id="aadharEditInput" maxlength="14" placeholder="XXXX XXXX XXXX" pattern="\d{12}" />
        <span asp-validation-for="AadharNumber" class="text-danger"></span>
    </div>
    <div class="form-group-custom">
        <label asp-for="PAN">PAN<span style="color:#dc3545">*</span></label>
        <input asp-for="PAN" class="form-control" maxlength="10" style="text-transform: uppercase;" placeholder="ABCDE1234F" />
        <span asp-validation-for="PAN" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-submit">Save Changes</button>
    <a asp-action="Customers" class="btn btn-back">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Aadhar number formatting
            $('#aadharEditInput').on('input', function(e) {
                let value = $(this).val().replace(/\s+/g, '');
                let numericValue = value.replace(/\D/g, '');
                if (numericValue.length > 12) numericValue = numericValue.substring(0, 12);
                let formatted = '';
                for (let i = 0; i < numericValue.length; i++) {
                    if (i > 0 && i % 4 === 0) formatted += ' ';
                    formatted += numericValue[i];
                }
                $(this).val(formatted);
            });
            $('form').on('submit', function() {
                let aadharValue = $('#aadharEditInput').val().replace(/\s+/g, '');
                $('#aadharEditInput').val(aadharValue);
            });

            // PAN uppercase
            $('input[asp-for="PAN"]').on('input', function() {
                let value = $(this).val().toUpperCase().replace(/[^A-Z0-9]/g, '');
                if (value.length > 10) value = value.substring(0, 10);
                $(this).val(value);
            });

            // Mobile validation (10 digits)
            $('input[asp-for="MobileNumber"]').on('input', function() {
                let value = $(this).val().replace(/\D/g, '');
                if (value.length > 10) value = value.substring(0, 10);
                $(this).val(value);
            });

            // Enhanced validation before submit
            $('form').on('submit', function(e) {
                let isValid = true;
                let aadhar = $('#aadharEditInput').val().replace(/\s+/g, '');
                if (aadhar.length !== 12 || !/^\d{12}$/.test(aadhar)) {
                    alert('Please enter a valid 12-digit Aadhar number');
                    $('#aadharEditInput').focus();
                    e.preventDefault();
                    return false;
                }
                let mobile = $('input[asp-for="MobileNumber"]').val();
                if (mobile.length !== 10 || !/^\d{10}$/.test(mobile)) {
                    alert('Please enter a valid 10-digit mobile number');
                    $('input[asp-for="MobileNumber"]').focus();
                    e.preventDefault();
                    return false;
                }
                let pan = $('input[asp-for="PAN"]').val();
                if (pan.length !== 10 || !/^[A-Z]{5}[0-9]{4}[A-Z]{1}$/.test(pan)) {
                    alert('Please enter a valid PAN number (e.g., ABCDE1234F)');
                    $('input[asp-for="PAN"]').focus();
                    e.preventDefault();
                    return false;
                }
                return isValid;
            });
        });
    </script>
}
