@model BankApp.Client.Dto.EditCustomerDto

@{
    ViewData["Title"] = "Edit Customer";
}

<style>
    :root {
        --bank-primary: #1e3a5f;
        --bank-secondary: #2c5f8d;
        --bank-accent: #3498db;
        --bank-success: #27ae60;
        --bank-success-dark: #229954;
        --bank-warning: #f39c12;
        --bank-light: #f8f9fa;
        --bank-border: #e1e8ed;
        --bank-shadow: rgba(30, 58, 95, 0.08);
    }

    .edit-customer-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
        min-height: calc(100vh - 56px);
        padding: 15px 0;
    }

    .breadcrumb-nav {
        background: white;
        border-radius: 6px;
        padding: 8px 16px;
        margin-bottom: 12px;
        box-shadow: 0 1px 4px var(--bank-shadow);
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
    }

        .breadcrumb-nav a {
            color: var(--bank-accent);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s ease;
        }

            .breadcrumb-nav a:hover {
                color: var(--bank-primary);
            }

        .breadcrumb-nav span {
            color: #6c757d;
        }

        .breadcrumb-nav .current {
            color: var(--bank-primary);
            font-weight: 600;
        }

    .edit-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 2px 12px var(--bank-shadow);
        border: 1px solid var(--bank-border);
        overflow: hidden;
        max-width: 1100px;
        margin: 0 auto;
    }

    .edit-card-header {
        background: linear-gradient(135deg, var(--bank-warning) 0%, #e67e22 100%);
        padding: 14px 20px;
        position: relative;
    }

        .edit-card-header h2 {
            margin: 0;
            font-size: 1.2rem;
            font-weight: 700;
            color: white;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .edit-card-header h2 i {
                font-size: 1.1rem;
            }

    .edit-card-body {
        padding: 20px 24px;
    }

    .form-grid-3col {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px 20px;
    }

    .form-grid-2col {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px 20px;
    }

    .form-group-custom {
        margin-bottom: 0;
    }

    .form-label {
        font-weight: 600;
        color: var(--bank-primary);
        margin-bottom: 4px;
        font-size: 0.8rem;
        display: block;
    }

    .required-indicator {
        color: #dc3545;
        margin-left: 2px;
    }

    .form-control,
    .form-select {
        border: 1px solid var(--bank-border);
        border-radius: 6px;
        padding: 7px 10px;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        background-color: #fafbfc;
        width: 100%;
        height: 34px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--bank-warning);
            box-shadow: 0 0 0 2px rgba(243, 156, 18, 0.1);
            outline: none;
            background-color: white;
        }

        .form-control.is-invalid {
            border-color: #dc3545;
        }

        .form-control.is-valid {
            border-color: var(--bank-success);
        }

    .text-danger {
        font-size: 0.7rem;
        margin-top: 2px;
        display: block;
        color: #dc3545;
    }

    .form-hint {
        font-size: 0.7rem;
        color: #6c757d;
        margin-top: 2px;
    }

    .section-divider {
        display: flex;
        align-items: center;
        margin: 16px 0 12px 0;
        gap: 8px;
    }

        .section-divider::before,
        .section-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--bank-border);
        }

    .section-title {
        color: var(--bank-primary);
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

        .section-title i {
            color: var(--bank-warning);
            font-size: 0.85rem;
        }

    .btn-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid var(--bank-border);
    }

    .btn-submit {
        background: linear-gradient(135deg, var(--bank-success) 0%, var(--bank-success-dark) 100%);
        color: white;
        font-weight: 600;
        border-radius: 6px;
        padding: 9px 24px;
        border: none;
        transition: all 0.2s ease;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 2px 8px rgba(39, 174, 96, 0.25);
        flex: 1;
        justify-content: center;
    }

        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(39, 174, 96, 0.35);
        }

        .btn-submit i {
            font-size: 0.9rem;
        }

    .btn-back {
        background: white;
        border: 1px solid var(--bank-border);
        color: var(--bank-primary);
        padding: 9px 24px;
        border-radius: 6px;
        font-weight: 600;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        flex: 1;
        justify-content: center;
    }

        .btn-back:hover {
            background: var(--bank-light);
            border-color: var(--bank-primary);
            text-decoration: none;
        }

        .btn-back i {
            font-size: 0.9rem;
        }

    .col-span-2 {
        grid-column: span 2;
    }

    .col-span-3 {
        grid-column: span 3;
    }

    @@media (max-width: 992px) {
        .form-grid-3col

    {
        grid-template-columns: repeat(2, 1fr);
    }

    .col-span-3 {
        grid-column: span 2;
    }

    }

    @@media (max-width: 768px) {
        .edit-customer-container

    {
        padding: 10px 0;
    }

    .edit-card {
        border-radius: 0;
        margin: 0 -15px;
    }

    .edit-card-body {
        padding: 16px;
    }

    .edit-card-header {
        padding: 12px 16px;
    }

    .form-grid-3col,
    .form-grid-2col {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .col-span-2,
    .col-span-3 {
        grid-column: span 1;
    }

    .btn-actions {
        flex-direction: column;
    }

    .breadcrumb-nav {
        margin: 0 -15px 10px -15px;
        border-radius: 0;
    }

    }
</style>

<div class="edit-customer-container">
    <div class="container-fluid px-3">
        <div class="breadcrumb-nav">
            <a asp-action="Customers" asp-controller="Manager">
                <i class="fas fa-users"></i> Customers
            </a>
            <span>/</span>
            <span class="current">Edit</span>
        </div>

        <div class="edit-card">
            <div class="edit-card-header">
                <h2>
                    <i class="fas fa-user-edit"></i>
                    Edit Customer Details
                </h2>
            </div>
            <div class="edit-card-body">
                <form asp-action="EditCustomer" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CustomerID" />
                    <input type="hidden" asp-for="UserName" />
                    <input type="hidden" asp-for="ApplicationUserID" />

                    <div class="section-divider">
                        <span class="section-title">
                            <i class="fas fa-user"></i> Personal Information
                        </span>
                    </div>

                    <div class="form-grid-3col">
                        <div class="form-group-custom">
                            <label class="form-label" asp-for="FullName">
                                Full Name<span class="required-indicator">*</span>
                            </label>
                            <input asp-for="FullName" class="form-control" maxlength="100" placeholder="Full name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="form-group-custom">
                            <label class="form-label" asp-for="DateOfBirth">
                                Date of Birth<span class="required-indicator">*</span>
                            </label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" min="1920-01-01" max="@DateTime.Now.AddYears(-10).ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>
                        <div class="form-group-custom">
                            <label class="form-label" asp-for="Gender">
                                Gender<span class="required-indicator">*</span>
                            </label>
                            <select asp-for="Gender" class="form-control">
                                <option value="">Select</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>
                        <div class="form-group-custom">
                            <label class="form-label" asp-for="Occupation">
                                Occupation<span class="required-indicator">*</span>
                            </label>
                            <input asp-for="Occupation" class="form-control" maxlength="50" placeholder="Occupation" />
                            <span asp-validation-for="Occupation" class="text-danger"></span>
                        </div>
                        <div class="form-group-custom col-span-2">
                            <label class="form-label" asp-for="MobileNumber">
                                Mobile Number<span class="required-indicator">*</span>
                            </label>
                            <input asp-for="MobileNumber" class="form-control" maxlength="10" placeholder="10-digit mobile" />
                            <span asp-validation-for="MobileNumber" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="section-divider">
                        <span class="section-title">
                            <i class="fas fa-id-card"></i> Identification
                        </span>
                    </div>

                    <div class="form-grid-2col">
                        <div class="form-group-custom">
                            <label class="form-label" asp-for="AadharNumber">
                                Aadhar Number<span class="required-indicator">*</span>
                            </label>
                            <input asp-for="AadharNumber" class="form-control" id="aadharEditInput" maxlength="14" placeholder="XXXX XXXX XXXX" />
                            <span asp-validation-for="AadharNumber" class="text-danger"></span>
                            @* <div class="form-hint">12-digit Aadhar</div> *@
                        </div>
                        <div class="form-group-custom">
                            <label class="form-label" asp-for="PAN">
                                PAN<span class="required-indicator">*</span>
                            </label>
                            <input asp-for="PAN" class="form-control" maxlength="10" style="text-transform: uppercase;" placeholder="ABCDE1234F" />
                            <span asp-validation-for="PAN" class="text-danger"></span>
                            @* <div class="form-hint">Format: ABCDE1234F</div> *@
                        </div>
                    </div>

                    <div class="btn-actions">
                        <button type="submit" class="btn-submit">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                        <a asp-action="Customers" class="btn-back">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $('#aadharEditInput').on('input', function(e) {
                let value = $(this).val().replace(/\s+/g, '');
                let numericValue = value.replace(/\D/g, '');
                if (numericValue.length > 12) numericValue = numericValue.substring(0, 12);
                let formatted = '';
                for (let i = 0; i < numericValue.length; i++) {
                    if (i > 0 && i % 4 === 0) formatted += ' ';
                    formatted += numericValue[i];
                }
                $(this).val(formatted);
            });

            $('form').on('submit', function() {
                $('#aadharEditInput').val($('#aadharEditInput').val().replace(/\s+/g, ''));
            });

            $('input[name="PAN"]').on('input', function() {
                let value = $(this).val().toUpperCase().replace(/[^A-Z0-9]/g, '');
                if (value.length > 10) value = value.substring(0, 10);
                $(this).val(value);
            });

            $('input[name="MobileNumber"]').on('input', function() {
                let value = $(this).val().replace(/\D/g, '');
                if (value.length > 10) value = value.substring(0, 10);
                $(this).val(value);
            });

            $('#aadharEditInput').on('blur', function() {
                let value = $(this).val().replace(/\s+/g, '');
                if (value.length > 0 && value.length !== 12) {
                    $(this).addClass('is-invalid').removeClass('is-valid');
                } else if (value.length === 12) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                }
            });

            $('input[name="MobileNumber"]').on('blur', function() {
                let value = $(this).val();
                if (value.length > 0 && value.length !== 10) {
                    $(this).addClass('is-invalid').removeClass('is-valid');
                } else if (value.length === 10) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                }
            });

            $('input[name="PAN"]').on('blur', function() {
                let value = $(this).val();
                let panRegex = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;
                if (value.length > 0 && !panRegex.test(value)) {
                    $(this).addClass('is-invalid').removeClass('is-valid');
                } else if (panRegex.test(value)) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                }
            });

            $('form').on('submit', function(e) {
                let aadhar = $('#aadharEditInput').val().replace(/\s+/g, '');
                if (aadhar.length !== 12 || !/^\d{12}$/.test(aadhar)) {
                    alert('Please enter a valid 12-digit Aadhar number');
                    $('#aadharEditInput').focus();
                    e.preventDefault();
                    return false;
                }
                let mobile = $('input[name="MobileNumber"]').val();
                if (mobile.length !== 10 || !/^\d{10}$/.test(mobile)) {
                    alert('Please enter a valid 10-digit mobile number');
                    $('input[name="MobileNumber"]').focus();
                    e.preventDefault();
                    return false;
                }
                let pan = $('input[name="PAN"]').val();
                if (pan.length !== 10 || !/^[A-Z]{5}[0-9]{4}[A-Z]{1}$/.test(pan)) {
                    alert('Please enter a valid PAN (e.g., ABCDE1234F)');
                    $('input[name="PAN"]').focus();
                    e.preventDefault();
                    return false;
                }
                return true;
            });
        });
    </script>
}
