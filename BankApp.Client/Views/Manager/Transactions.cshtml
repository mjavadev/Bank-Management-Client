@model List<BankApp.Client.Dto.TransactionDto>

@{
    ViewData["Title"] = "All Transactions";
}

<style>
    :root {
        --bank-primary: #1e3a5f;
        --bank-secondary: #2c5f8d;
        --bank-accent: #3498db;
        --bank-success: #27ae60;
        --bank-warning: #f39c12;
        --bank-danger: #e74c3c;
        --bank-info: #16a085;
        --bank-light: #f8f9fa;
        --bank-border: #e1e8ed;
        --bank-shadow: rgba(30, 58, 95, 0.08);
    }

    .all-transactions-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
        min-height: calc(100vh - 56px - 50px);
        padding: 20px 0;
    }

    /* Compact Page Header */
    .page-header {
        background: white;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 20px;
        box-shadow: 0 4px 16px var(--bank-shadow);
        border-left: 6px solid var(--bank-accent);
    }

    .page-header h2 {
        color: var(--bank-primary);
        font-weight: 700;
        font-size: 1.4rem;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .page-header h2 i {
        color: var(--bank-accent);
        font-size: 1.3rem;
    }

    .page-subtitle {
        color: #6c757d;
        margin: 4px 0 0 0;
        font-size: 0.85rem;
    }

    /* Compact Statistics */
    .transaction-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: white;
        border-radius: 8px;
        padding: 14px 16px;
        box-shadow: 0 2px 8px var(--bank-shadow);
        border-left: 3px solid;
        transition: all 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(30, 58, 95, 0.12);
    }

    .stat-card.total { border-left-color: var(--bank-accent); }
    .stat-card.deposit { border-left-color: var(--bank-success); }
    .stat-card.withdrawal { border-left-color: var(--bank-danger); }
    .stat-card.transfer { border-left-color: var(--bank-info); }
    .stat-card.pending { border-left-color: var(--bank-warning); }
    .stat-card.approved { border-left-color: var(--bank-success); }

    .stat-label {
        color: #6c757d;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .stat-value {
        color: var(--bank-primary);
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
    }

    /* Compact Main Card */
    .transactions-card {
        background: white;
        border-radius: 10px;
        border: 1px solid var(--bank-border);
        box-shadow: 0 4px 16px var(--bank-shadow);
        overflow: hidden;
    }

    .transactions-card-header {
        background: linear-gradient(135deg, var(--bank-light) 0%, #ffffff 100%);
        padding: 14px 18px;
        border-bottom: 2px solid var(--bank-border);
    }

    .transactions-card-header h5 {
        margin: 0;
        color: var(--bank-primary);
        font-weight: 700;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .transactions-card-header h5 i {
        color: var(--bank-accent);
        font-size: 1rem;
    }

    .transactions-card-body {
        padding: 18px;
    }

    /* Compact Table */
    .transactions-table {
        width: 100%;
        font-size: 0.9rem;
    }

    .transactions-table thead th {
        background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
        color: white;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.3px;
        padding: 10px 8px;
        border: none;
        white-space: nowrap;
    }

    .transactions-table thead th:first-child {
        border-top-left-radius: 6px;
    }

    .transactions-table thead th:last-child {
        border-top-right-radius: 6px;
    }

    .transactions-table tbody tr {
        transition: all 0.2s ease;
        border-bottom: 1px solid var(--bank-border);
    }

    .transactions-table tbody tr:hover {
        background: linear-gradient(90deg, rgba(52, 152, 219, 0.05) 0%, rgba(30, 58, 95, 0.03) 100%);
    }

    .transactions-table tbody td {
        padding: 10px 8px;
        vertical-align: middle;
        color: var(--bank-primary);
        font-size: 0.85rem;
    }

    .transactions-table tbody tr:last-child {
        border-bottom: none;
    }

    /* Transaction ID */
    .transaction-id {
        font-weight: 600;
        color: var(--bank-accent);
        font-family: 'Courier New', monospace;
        font-size: 0.85rem;
    }

    /* Account Number */
    .account-number {
        font-family: 'Courier New', monospace;
        letter-spacing: 0.5px;
        color: var(--bank-primary);
        font-weight: 500;
        font-size: 0.82rem;
    }

    /* Amount Styling */
    .amount-cell {
        font-weight: 700;
        font-family: 'Courier New', monospace;
        font-size: 0.95rem;
    }

    .amount-deposit { color: var(--bank-success); }
    .amount-withdrawal { color: var(--bank-danger); }
    .amount-transfer { color: var(--bank-accent); }

    /* Compact Badges */
    .transaction-type-badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
    }

    .badge-deposit {
        background: rgba(39, 174, 96, 0.15);
        color: var(--bank-success);
    }

    .badge-withdrawal {
        background: rgba(231, 76, 60, 0.15);
        color: var(--bank-danger);
    }

    .badge-transfer {
        background: rgba(52, 152, 219, 0.15);
        color: var(--bank-accent);
    }

    .status-badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
    }

    .badge-pending {
        background: rgba(243, 156, 18, 0.15);
        color: var(--bank-warning);
    }

    .badge-approved {
        background: rgba(39, 174, 96, 0.15);
        color: var(--bank-success);
    }

    .badge-rejected {
        background: rgba(231, 76, 60, 0.15);
        color: var(--bank-danger);
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

    .empty-state-icon {
        width: 90px;
        height: 90px;
        background: linear-gradient(135deg, var(--bank-light) 0%, #e9ecef 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
    }

    .empty-state-icon i {
        font-size: 2.5rem;
        color: var(--bank-accent);
    }

    .empty-state h5 {
        color: var(--bank-primary);
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 1.1rem;
    }

    .empty-state p {
        color: #6c757d;
        font-size: 0.9rem;
    }

    /* DataTables Custom Styling */
    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
        border: 1px solid var(--bank-border);
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 0.85rem;
        transition: all 0.2s ease;
    }

    .dataTables_wrapper .dataTables_length select:focus,
    .dataTables_wrapper .dataTables_filter input:focus {
        border-color: var(--bank-accent);
        outline: none;
        box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.1);
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
        border-radius: 6px;
        padding: 6px 12px;
        margin: 0 2px;
        border: 1px solid var(--bank-border);
        background: white;
        color: var(--bank-primary);
        transition: all 0.2s ease;
        font-size: 0.85rem;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
        color: white !important;
        border-color: var(--bank-primary);
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: linear-gradient(135deg, var(--bank-primary) 0%, var(--bank-secondary) 100%);
        color: white !important;
        border-color: var(--bank-primary);
    }

    .dataTables_wrapper .dataTables_info {
        color: #6c757d;
        font-size: 0.82rem;
        padding: 8px 0;
    }

    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        font-size: 0.85rem;
    }

    @@media (max-width: 768px) {
        .page-header h2 {
            font-size: 1.2rem;
        }

        .transaction-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .transactions-card-body {
            padding: 12px;
        }

        .stat-card {
            padding: 12px;
        }

        .stat-value {
            font-size: 1.3rem;
        }
    }
</style>

<div class="all-transactions-container">
    <div class="container-fluid px-3">
        <!-- Page Header -->
        <div class="page-header">
            <h2>
                <i class="fas fa-exchange-alt"></i>
                All Transactions
            </h2>
            <p class="page-subtitle">Complete transaction history across all customer accounts</p>
        </div>

        <!-- Transaction Statistics -->
        @if (Model.Any())
        {
            var totalCount = Model.Count();
            var deposits = Model.Where(t => t.TransactionType == 1).Count();
            var withdrawals = Model.Where(t => t.TransactionType == 2).Count();
            var transfers = Model.Where(t => t.TransactionType == 3).Count();
            var pending = Model.Where(t => t.Status == 1).Count();
            var approved = Model.Where(t => t.Status == 2).Count();

            <div class="transaction-stats">
                <div class="stat-card total">
                    <div class="stat-label">
                        <i class="fas fa-list"></i> Total
                    </div>
                    <h3 class="stat-value">@totalCount</h3>
                </div>
                <div class="stat-card deposit">
                    <div class="stat-label">
                        <i class="fas fa-arrow-down"></i> Deposits
                    </div>
                    <h3 class="stat-value">@deposits</h3>
                </div>
                <div class="stat-card withdrawal">
                    <div class="stat-label">
                        <i class="fas fa-arrow-up"></i> Withdrawals
                    </div>
                    <h3 class="stat-value">@withdrawals</h3>
                </div>
                <div class="stat-card transfer">
                    <div class="stat-label">
                        <i class="fas fa-exchange-alt"></i> Transfers
                    </div>
                    <h3 class="stat-value">@transfers</h3>
                </div>
                <div class="stat-card pending">
                    <div class="stat-label">
                        <i class="fas fa-clock"></i> Pending
                    </div>
                    <h3 class="stat-value">@pending</h3>
                </div>
                <div class="stat-card approved">
                    <div class="stat-label">
                        <i class="fas fa-check-circle"></i> Approved
                    </div>
                    <h3 class="stat-value">@approved</h3>
                </div>
            </div>
        }

        <!-- Main Transactions Card -->
        <div class="row">
            <div class="col-12">
                <div class="transactions-card">
                    <div class="transactions-card-header">
                        <h5><i class="fas fa-table"></i> Transaction History</h5>
                    </div>
                    <div class="transactions-card-body">
                        @if (Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="transactions-table table table-hover" id="transactionsTable">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Date & Time</th>
                                            <th>Type</th>
                                            <th>Account</th>
                                            <th>Amount</th>
                                            <th>Recipient</th>
                                            <th>Status</th>
                                            <th>Description</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var txn in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="transaction-id">#@txn.TransactionID</span>
                                                </td>
                                                <td>
                                                    <div style="line-height: 1.3;">@txn.TransactionDate.ToString("dd MMM yyyy")</div>
                                                    <small style="color: #6c757d; font-size: 0.75rem;">@txn.TransactionDate.ToString("HH:mm")</small>
                                                </td>
                                                <td>
                                                    @switch (txn.TransactionType)
                                                    {
                                                        case 1:
                                                            <span class="transaction-type-badge badge-deposit">
                                                                <i class="fas fa-arrow-down"></i> Deposit
                                                            </span>
                                                            break;
                                                        case 2:
                                                            <span class="transaction-type-badge badge-withdrawal">
                                                                <i class="fas fa-arrow-up"></i> Withdrawal
                                                            </span>
                                                            break;
                                                        case 3:
                                                            <span class="transaction-type-badge badge-transfer">
                                                                <i class="fas fa-exchange-alt"></i> Transfer
                                                            </span>
                                                            break;
                                                    }
                                                </td>
                                                <td>
                                                    <span class="account-number">@txn.AccountNumber</span>
                                                </td>
                                                <td>
                                                    <span class="amount-cell @(txn.TransactionType == 1 ? "amount-deposit" : txn.TransactionType == 2 ? "amount-withdrawal" : "amount-transfer")">
                                                        @(txn.TransactionType == 1 ? "+" : txn.TransactionType == 2 ? "-" : "")₹@txn.Amount.ToString("N2")
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(txn.RecipientAccountNumber))
                                                    {
                                                        <span class="account-number">@txn.RecipientAccountNumber</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: #6c757d; font-style: italic; font-size: 0.8rem;">N/A</span>
                                                    }
                                                </td>
                                                <td>
                                                    @switch (txn.Status)
                                                    {
                                                        case 1:
                                                            <span class="status-badge badge-pending">
                                                                <i class="fas fa-clock"></i> Pending
                                                            </span>
                                                            break;
                                                        case 2:
                                                            <span class="status-badge badge-approved">
                                                                <i class="fas fa-check-circle"></i> Approved
                                                            </span>
                                                            break;
                                                        case 3:
                                                            <span class="status-badge badge-rejected">
                                                                <i class="fas fa-times-circle"></i> Rejected
                                                            </span>
                                                            break;
                                                    }
                                                </td>
                                                <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                    @if (!string.IsNullOrEmpty(txn.Description))
                                                    {
                                                        <span title="@txn.Description">@txn.Description</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: #6c757d; font-style: italic; font-size: 0.8rem;">No description</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <i class="fas fa-receipt"></i>
                                </div>
                                <h5>No Transactions Found</h5>
                                <p>There are no transactions in the system yet. Transactions will appear here once customers start making them.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#transactionsTable').DataTable({
                "pageLength": 25,
                "order": [[1, "desc"]],
                "language": {
                    "search": "Search transactions:",
                    "lengthMenu": "Show _MENU_ per page",
                    "info": "Showing _START_ to _END_ of _TOTAL_ transactions",
                    "infoEmpty": "No transactions available",
                    "infoFiltered": "(filtered from _MAX_ total)",
                    "paginate": {
                        "first": "First",
                        "last": "Last",
                        "next": "Next",
                        "previous": "Prev"
                    }
                },
                "responsive": true,
                "dom": '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip'
            });
        });
    </script>
}
